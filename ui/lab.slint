import "../assets/icons/bootstrap-icons.ttf";
import "../assets/icons/material-icons.ttf";
export { Palette } from "std-widgets.slint";
import { Palette, VerticalBox, HorizontalBox, Button, ComboBox, CheckBox, LineEdit, TextEdit, SpinBox, Slider, ScrollView } from "std-widgets.slint";
export global Ink {
    in-out property <bool> light: false;
    in-out property<bool> liquid-glass: false;
    changed light => { Palette.color-scheme = light ? ColorScheme.light : ColorScheme.dark; }
    out property <color> text: light ? #151515 : #DFDEDC;
    out property <color> muted: light ? #646560 : #A6A7A2;
    out property <color> canvas: light ? #DFDEDC : #111212;
    out property <color> surface: light ? #f7f7f4 : #232525;
    out property <color> edge: light ? #ffffffb0 : #DFDEDC28;
    in-out property <color> accent: #00ACAC;
    in-out property <bool> custom-background: false;
    in-out property <color> background-color: #111212;
    out property <color> panel-background: custom-background ? background-color : canvas;
}
export global MenuInk {
    in-out property <color> background: #111212;
    in-out property <color> surface: #232525D9;
    in-out property <color> icons: #DFDEDC;
    in-out property <color> text: #DFDEDC;
    in-out property <color> muted: #A6A7A2;
    in-out property <color> border: #DFDEDC28;
    in-out property <color> title: #00ACAC;
    in-out property <color> selection-background: #00ACAC33;
    in-out property <color> selection-icon: #00ACAC;
    in-out property <color> selection-border: #00ACAC;
    in-out property <color> shadow: #00000030;
    in-out property<float> opacity: 0.92;
    in-out property<color> center-background: #111212C0;
    in-out property<color> center-border: #DFDEDC28;
    in-out property<float> center-radius: 64;
    in-out property<bool> liquid-glass: false;
    in-out property<float> glass-strength: 0.5;
    in-out property<color> glass-highlight: #FFFFFF;
}
component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> accent: false;
    callback clicked;
    min-height: 36px; min-width: label.preferred-width + 28px;
    border-radius: 10px; border-width: 1px;
    border-color: accent ? Ink.accent.with-alpha(0.5) : Ink.edge;
    background: touch.pressed ? Ink.accent.with-alpha(0.33) : touch.has-hover ? Ink.accent.with-alpha(0.14) : accent ? Ink.accent.with-alpha(0.19) : Ink.liquid-glass ? @linear-gradient(130deg, Ink.surface.brighter(18%).with-alpha(0.8), Ink.surface.with-alpha(0.35)) : Ink.surface;
    animate background { duration: 110ms; }
    label := Text { text: root.text; color: root.accent ? Ink.accent : Ink.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button; accessible-label: root.text; accessible-action-default => { root.clicked(); }
}
component ColorControl inherits Rectangle {
    in property<color> value;
    in property<bool> allow-alpha: true;
    in property<bool> en: false;
    callback pick;
    callback alpha-changed(float);
    callback reset;
    background: transparent;
    VerticalBox { padding: 0px; spacing: 4px;
        HorizontalBox { padding: 0px; spacing: 8px;
            Rectangle { width: 34px; height: 30px; border-radius: 8px; border-width: 1px; border-color: Ink.edge; background: @linear-gradient(45deg, #777777, #bbbbbb);
                Rectangle { border-radius: 8px; background: root.value; }
                TouchArea { clicked => { root.pick(); } }
            }
            Pill { text: root.en ? "Choose color…" : "Escolher cor…"; clicked => { root.pick(); } }
            Pill { text: root.en ? "Default" : "Padrão"; clicked => { root.reset(); } }
        }
        if root.allow-alpha: HorizontalBox { padding: 0px; spacing: 6px;
            Text { text: round(root.value.alpha * 100 / 255.0) + "%"; color: Ink.muted; font-size: 10px; width: 33px; vertical-alignment: center; }
            Slider { value: root.value.alpha * 100 / 255.0; minimum: 0; maximum: 100; changed(v) => { root.alpha-changed(v); } }
        }
    }
}
component Caption inherits Text { color: Ink.muted; font-size: 11px; }
component Heading inherits Text { color: Ink.text; font-size: 21px; font-weight: 600; }
export global BrandIcons {
    public pure function image-for-id(id: string) -> image {
        if id == "brand:voicemeeter" { return @image-url("../assets/icons/custom/voicemeeter.svg"); }
        if id == "brand:chatgpt" { return @image-url("../assets/icons/custom/chatgpt.svg"); }
        return @image-url("");
    }
}
export struct RingItem { icon-id: string, x: float, y: float, glyph: string, family: string, label: string, image: image, filled: bool, tint: color, custom-icon: bool, custom-background: bool, custom-border: bool, background-color: color, border-color: color }
export struct IconChoice { image: image, id: string, label: string, glyph: string, family: string }
component Face inherits Rectangle {
    in property<float> zoom: 1;
    in property <[RingItem]> items;
    in property <int> selected: -1;
    in property <bool> interactive: false;
    in property <string> center-title: "ORBIT AXION";
    in property <string> center-text: "";
    in property <float> glass-opacity: MenuInk.opacity;
    callback pick(int);
    callback reorder(int,float,float);
    background: transparent;
    Rectangle { x: parent.width / 2 - 152px * root.zoom; y: parent.height / 2 - 152px * root.zoom; width: 304px * root.zoom; height: 304px * root.zoom;
        border-radius: 152px * root.zoom; border-width: 1px; border-color: MenuInk.border;
        background: @linear-gradient(115deg, MenuInk.background.brighter(8%).with-alpha(MenuInk.background.alpha / 255.0 * root.glass-opacity), MenuInk.background.with-alpha(MenuInk.background.alpha / 255.0 * root.glass-opacity));
        drop-shadow-blur: 22px; drop-shadow-offset-y: 8px; drop-shadow-color: MenuInk.shadow;
    }
    if MenuInk.liquid-glass: Rectangle {
        x: parent.width / 2 - 152px * root.zoom; y: parent.height / 2 - 152px * root.zoom; width: 304px * root.zoom; height: 304px * root.zoom;
        border-radius: 152px * root.zoom; border-width: 1px; border-color: MenuInk.glass-highlight.with-alpha(MenuInk.glass-highlight.alpha / 255.0 * MenuInk.glass-strength * 0.4);
        background: @linear-gradient(135deg, MenuInk.glass-highlight.with-alpha(MenuInk.glass-highlight.alpha / 255.0 * MenuInk.glass-strength * 0.18), transparent, MenuInk.glass-highlight.with-alpha(MenuInk.glass-highlight.alpha / 255.0 * MenuInk.glass-strength * 0.035));
    }
    for item[i] in root.items: Rectangle {
        property <image> resolved-icon: item.image.width > 0 ? item.image : BrandIcons.image-for-id(item.icon-id);
        x: parent.width / 2 + item.x * 1px * root.zoom - 29px * root.zoom; y: parent.height / 2 + item.y * 1px * root.zoom - 29px * root.zoom;
        width: 58px * root.zoom; height: 58px * root.zoom; border-radius: 29px * root.zoom; border-width: 1px;
        border-color: root.selected == i && !root.interactive ? MenuInk.selection-border : item.custom-border ? item.border-color : MenuInk.border;
        background: root.selected == i && !root.interactive ? MenuInk.selection-background : item.custom-background ? item.background-color : @linear-gradient(120deg, MenuInk.surface.brighter(12%), MenuInk.surface);
        animate background { duration: 100ms; }
        if MenuInk.liquid-glass: Rectangle {
            border-radius: 29px * root.zoom; border-width: 1px; border-color: MenuInk.glass-highlight.with-alpha(MenuInk.glass-highlight.alpha / 255.0 * MenuInk.glass-strength * 0.4);
            background: @linear-gradient(130deg, MenuInk.glass-highlight.with-alpha(MenuInk.glass-highlight.alpha / 255.0 * MenuInk.glass-strength * 0.24), transparent, MenuInk.glass-highlight.with-alpha(MenuInk.glass-highlight.alpha / 255.0 * MenuInk.glass-strength * 0.04));
        }
        Text { visible: parent.resolved-icon.width == 0; text: item.glyph; color: root.selected == i && !root.interactive ? MenuInk.selection-icon : item.filled ? (item.custom-icon ? item.tint : MenuInk.icons) : MenuInk.muted.with-alpha(MenuInk.muted.alpha / 255.0 * 0.5); font-family: item.family; font-size: 23px * root.zoom; horizontal-alignment: center; vertical-alignment: center; }
        Image { visible: parent.resolved-icon.width > 0; source: parent.resolved-icon; x: 16px * root.zoom; y: 16px * root.zoom; width: 26px * root.zoom; height: 26px * root.zoom; image-fit: contain; colorize: item.custom-icon ? item.tint : transparent; opacity: item.custom-icon && item.tint.alpha == 0 ? 0 : 1; }
        if root.interactive && root.selected == i: Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; border-radius: 32px * root.zoom; border-width: 1px; border-color: MenuInk.selection-border; background: transparent; }
        area := TouchArea { enabled: root.interactive;
            clicked => { root.pick(i); }
            pointer-event(e) => { if e.kind == PointerEventKind.up { root.reorder(i, self.mouse-x / 1px + item.x - 29, self.mouse-y / 1px + item.y - 29); } }
        }
    }
    Rectangle { x: parent.width / 2 - MenuInk.center-radius * 1px * root.zoom; y: parent.height / 2 - MenuInk.center-radius * 1px * root.zoom; width: MenuInk.center-radius * 2px * root.zoom; height: MenuInk.center-radius * 2px * root.zoom;
        border-radius: MenuInk.center-radius * 1px * root.zoom; background: MenuInk.center-background; border-width: 1px; border-color: MenuInk.center-border;
        VerticalLayout { padding: 3px; spacing: 5px;
            Text { text: root.center-title; color: MenuInk.title; font-size: 10px * root.zoom; font-weight: 600; horizontal-alignment: center; }
            Text { text: root.center-text; color: MenuInk.text; font-size: min(14px, MenuInk.center-radius / 4 * 1px) * root.zoom; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
            Text { text: "ORBIT / 08"; color: MenuInk.muted; font-size: 9px * root.zoom; horizontal-alignment: center; }
        }
    }
}
export component Ring inherits Window {
    in property<float> zoom: 1;
    in property <[RingItem]> items;
    title: "Orbit Axion · Ring"; width: 360px * root.zoom; height: 360px * root.zoom; no-frame: true; background: transparent;
    in property <int> selected: -1;
    in property <string> level;
    in property <string> query;
    in property <string> profile-name;
    Face { zoom: root.zoom; items: root.items; selected: root.selected;
        center-title: root.query != "" ? "BUSCA / SEARCH" : root.profile-name;
        center-text: root.query != "" ? root.query : root.selected >= 0 ? root.items[root.selected].label + (root.level != "" ? "\n" + root.level : "") : "Orbit Axion";
    }
}
export component Tray inherits SystemTrayIcon {
    in property <bool> en: false;
    in property <bool> paused: false;
    in property <image> tray-image;
    icon: tray-image; tooltip: "Orbit Axion";
    callback open-editor;
    callback toggle;
    callback quit;
    clicked => { root.open-editor(); }
    Menu {
        MenuItem { title: root.en ? "Open Orbit Axion" : "Abrir Orbit Axion"; activated => { root.open-editor(); } }
        MenuItem { title: root.paused ? (root.en ? "Resume" : "Retomar") : (root.en ? "Pause capture" : "Pausar captura"); activated => { root.toggle(); } }
        MenuSeparator {}
        MenuItem { title: root.en ? "Quit" : "Sair"; activated => { root.quit(); } }
    }
}
export component Editor inherits Window {
    in property<string> notice;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in property <[RingItem]> items;
    title: "Orbit Axion"; preferred-width: 1160px; preferred-height: 800px; min-width: 1080px; min-height: 760px;
    background: Ink.panel-background.with-alpha(root.glass-strength / 100);
    in property <[string]> profiles;
    in property <[string]> menus;
    in-out property <int> profile-index: 0;
    in-out property <int> menu-index: 0;
    in-out property <int> slot-index: 0;
    in property <bool> armed: false;
    in-out property <bool> en: false;
    in-out property <int> page: 0;
    in property <string> status: "";
    in property <string> diagnostic;
    in property <string> update-status;
    in-out property<string> menu-name;
    in property<string> technical-log;
    in-out property <string> slot-name;
    in-out property <int> action-type: 0;
    in-out property <string> target;
    in-out property <string> arguments;
    in-out property <string> shortcut;
    in-out property <string> text-value;
    in-out property <int> command-index: 0;
    in-out property <int> audio-provider: 0;
    in property<[string]> strip-labels: ["Strip 0","Strip 1","Strip 2","Strip 3","Strip 4","Strip 5","Strip 6","Strip 7"];
    in property<[string]> bus-labels: ["Bus 0","Bus 1","Bus 2","Bus 3","Bus 4"];
    in property<[string]> audio-endpoints: ["Padrão / Default"];
    in-out property<int> audio-endpoint: 0;
    in-out property <int> audio-target: 0;
    in-out property <float> audio-step: 2;
    in-out property <bool> confirm: false;
    in-out property <bool> elevated: false;
    in-out property <int> submenu-index: 0;
    in-out property <string> icon-name;
    in-out property <bool> icon-is-file: false;
    in-out property <float> icon-grayscale: 0;
    in-out property <float> icon-brightness: 0;
    in-out property <float> icon-contrast: 100;
    in-out property <bool> icon-invert: false;
    in-out property<string> icon-color;
    in-out property<string> accent-hex: "#00ACAC";
    changed accent-hex => { root.preview-background(); }
    in-out property<string> background-hex;
    changed background-hex => { root.preview-background(); }
    changed glass-strength => { root.preview-background(); }
    callback preview-background;
    callback save-menu-style;
    callback pick-color(int);
    callback color-opacity(int,float);
    callback reset-color(int);
    callback refresh-icons;
    callback choose-icon(string);
    in property<[IconChoice]> icon-choices;
    in property<int> icon-count: 0;
    in-out property<int> icon-library: 0;
    in-out property<int> icon-page: 0;
    in-out property<string> icon-query;
    changed icon-query => { root.icon-page = 0; root.refresh-icons(); }
    in-out property<bool> menu-liquid-glass: false;
    changed menu-liquid-glass => { root.preview-background(); }
    in-out property<float> menu-glass-strength: 50;
    changed menu-glass-strength => { root.preview-background(); }
    in-out property<float> menu-center-radius: 64;
    changed menu-center-radius => { root.preview-background(); }
    in-out property<string> button-background;
    in-out property<string> button-border;
    in property<color> icon-color-preview;
    in property<color> button-background-preview;
    in property<color> button-border-preview;
    changed button-background => { root.preview-slot(); }
    changed button-border => { root.preview-slot(); }
    changed icon-color => { root.preview-slot(); }
    in-out property<string> menu-center-background-hex: "#111212C0";
    changed menu-center-background-hex => { root.preview-background(); }
    in-out property<string> menu-center-border-hex: "#DFDEDC28";
    changed menu-center-border-hex => { root.preview-background(); }
    in-out property<string> menu-glass-highlight-hex: "#FFFFFF";
    changed menu-glass-highlight-hex => { root.preview-background(); }

    in-out property<float> menu-opacity: 92;
    changed menu-opacity => { root.preview-background(); }
    in-out property<string> menu-background-hex: "#111212";
    changed menu-background-hex => { root.preview-background(); }
    in-out property<string> menu-surface-hex: "#232525D9";
    changed menu-surface-hex => { root.preview-background(); }
    in-out property<string> menu-icons-hex: "#DFDEDC";
    changed menu-icons-hex => { root.preview-background(); }
    in-out property<string> menu-text-hex: "#DFDEDC";
    changed menu-text-hex => { root.preview-background(); }
    in-out property<string> menu-muted-hex: "#A6A7A2";
    changed menu-muted-hex => { root.preview-background(); }
    in-out property<string> menu-border-hex: "#DFDEDC28";
    changed menu-border-hex => { root.preview-background(); }
    in-out property<string> menu-title-hex: "#00ACAC";
    changed menu-title-hex => { root.preview-background(); }
    in-out property<string> menu-selection-background-hex: "#00ACAC33";
    changed menu-selection-background-hex => { root.preview-background(); }
    in-out property<string> menu-selection-icon-hex: "#00ACAC";
    changed menu-selection-icon-hex => { root.preview-background(); }
    in-out property<string> menu-selection-border-hex: "#00ACAC";
    changed menu-selection-border-hex => { root.preview-background(); }
    in-out property<string> menu-shadow-hex: "#00000030";
    changed menu-shadow-hex => { root.preview-background(); }

    in-out property <string> profile-name;
    in-out property <string> executables;
    in-out property <int> priority: 0;
    in-out property <bool> inherit: true;
    in-out property <bool> profile-enabled: true;
    in-out property <bool> automatic: true;
    in-out property <int> mouse-button: 1;
    in-out property <int> trigger-source: 0;
    in-out property <int> keyboard-key: 0;
    in property <string> keyboard-name: "";
    in property <[string]> keyboard-options;
    in-out property<int> keyboard-index: 0;
    callback select-keyboard-key(int);
    in-out property <bool> hold: true;
    in-out property <int> hold-ms: 220;
    in-out property <float> distance: 48;
    in-out property <float> glass-strength: 92;
    in-out property <int> theme: 0;
    in-out property<bool> app-liquid-glass: false;
    changed app-liquid-glass => { root.preview-background(); }
    in-out property <bool> startup: false;
    in-out property <bool> sounds: false;
    in-out property<float> sound-volume: 30;
    in-out property<int> menu-size: 360;
    in-out property <bool> updates: true;
    in-out property <string> repository: "whoslucaxs/orbit-axion";
    in property <[string]> macro-steps;
    in-out property <int> macro-index: 0;
    in-out property <int> macro-kind: 0;
    in property<[string]> macro-source-names;
    in-out property<int> macro-source-slot: 0;
    in-out property <int> macro-delay: 100;
    in-out property <string> macro-value;
    callback switch-profile(int);
    callback switch-menu(int);
    callback pick-slot(int);
    callback reorder(int,float,float);
    callback rename-menu;
    callback delete-menu;
    callback preview-slot;
    callback macro-update;
    callback save-slot;
    callback refresh-audio;
    callback browse-target;
    callback import-icon;
    callback import-executable-icon;
    callback new-profile;
    callback duplicate-profile;
    callback delete-profile;
    callback save-profile;
    callback browse-executable;
    callback new-menu;
    callback save-settings;
    callback learn-button;
    callback toggle-capture;
    callback import-config;
    callback export-config;
    callback export-profile;
    callback restore-backup;
    callback reset-defaults;
    callback show-data;
    callback diagnostics-export;
    callback check-updates;
    callback install-update;
    callback cancel-macro;
    callback macro-add;
    callback macro-remove;
    callback macro-up;
    callback pump;
    HorizontalLayout {
        Rectangle { width: 204px; background: Ink.surface.with-alpha(Ink.liquid-glass ? 0.3 : 0.55);
            Rectangle { x: parent.width - 1px; width: 1px; background: Ink.edge; }
            VerticalLayout { padding: 22px; spacing: 10px;
                Text { text: "◎"; color: Ink.accent; font-size: 40px; height: 58px; }
                Text { text: "Orbit Axion"; color: Ink.text; font-size: 22px; font-weight: 600; }
                Caption { text: "YOUR FLOW, IN ORBIT"; height: 32px; font-size: 9px; }
                for name[i] in [root.en ? "Menus & actions" : "Menus e ações", root.en ? "Profiles" : "Perfis", root.en ? "App preferences" : "Preferências do app"]: Pill { text: name; accent: root.page == i; clicked => { root.page = i; } }
                Pill { text: root.en ? "Menu colors" : "Cores do menu"; accent: root.page == 4; clicked => { root.page = 4; } }
                Pill { text: root.en ? "Diagnostics" : "Diagnóstico"; accent: root.page == 3; clicked => { root.page = 3; } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Caption { text: root.armed ? (root.en ? "●  Capture active" : "●  Captura ativa") : (root.en ? "○  Capture paused" : "○  Captura pausada"); color: root.armed ? Ink.accent : Ink.muted; }
                Pill { text: root.armed ? (root.en ? "Pause" : "Pausar") : (root.en ? "Resume" : "Retomar"); clicked => { root.toggle-capture(); } }
                Caption { text: "Rust + Slint / GPL v3"; height: 24px; font-size: 10px; }
            }
        }
        VerticalLayout { padding: 28px; spacing: 18px;
            HorizontalLayout {
                VerticalLayout { spacing: 5px;
                    Caption { text: root.en ? "WORKSPACE / PERSONAL" : "ESPAÇO / PESSOAL"; color: Ink.accent; }
                    Heading { text: root.page == 0 ? (root.en ? "Make room for your flow." : "Seu fluxo, ao alcance do mouse.") : root.page == 1 ? (root.en ? "A ring for every context." : "Um anel para cada contexto.") : root.page == 2 ? (root.en ? "Quietly yours." : "Do seu jeito, sem excessos.") : root.page == 6 ? (root.en ? "Make the icon yours." : "O ícone do seu jeito.") : root.page == 5 ? (root.en ? "An icon for every action." : "Um ícone para cada ação.") : root.page == 4 ? (root.en ? "Your menu. Your palette." : "Seu menu. Sua paleta.") : (root.en ? "Under the surface." : "Por dentro do Orbit."); }
                }
                Pill { text: root.en ? "Export" : "Exportar"; clicked => { root.export-config(); } }
                Pill { text: root.en ? "Import" : "Importar"; clicked => { root.import-config(); } }
            }
            if root.page == 0: HorizontalLayout { spacing: 22px;
                Rectangle { horizontal-stretch: 1; min-width: 350px; border-radius: 18px; border-width: 1px; border-color: Ink.edge; background: @linear-gradient(130deg, Ink.surface.with-alpha(0.82), Ink.surface.with-alpha(0.32));
                    VerticalLayout { padding: 18px; spacing: 12px;
                        HorizontalLayout {
                            ComboBox { model: root.profiles; current-index: root.profile-index; selected(value) => { root.profile-index = self.current-index; root.switch-profile(self.current-index); } }
                            ComboBox { model: root.menus; current-index: root.menu-index; selected(value) => { root.menu-index = self.current-index; root.switch-menu(self.current-index); } }
                        }
                        Face { min-width: 320px; min-height: 342px; items: root.items; selected: root.slot-index; interactive: true; center-title: "LIVE PREVIEW"; center-text: root.items[root.slot-index].label; pick(i) => { root.pick-slot(i); } reorder(i,x,y) => { root.reorder(i,x,y); } }
                        Caption { text: root.en ? "Eight positions. Drag an icon to reorder." : "Oito posições. Arraste um ícone para reorganizar."; horizontal-alignment: center; wrap: word-wrap; }
                        LineEdit { text <=> root.menu-name; placeholder-text: root.en ? "Menu name" : "Nome do menu"; }
                        HorizontalBox { padding: 0px; Pill { text: root.en ? "Rename" : "Renomear"; clicked=>{root.rename-menu();} } Pill { text: root.en ? "Remove menu" : "Remover menu"; clicked=>{root.delete-menu();} } }
                        Pill { text: root.en ? "+ New submenu" : "+ Novo submenu"; clicked => { root.new-menu(); } }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        Caption { text: root.en ? "Open with your mouse. Scroll over volume to adjust it." : "Abra com o mouse. Role sobre um ícone de volume para ajustar."; wrap: word-wrap; }
                    }
                }
                Rectangle { width: 342px; border-radius: 18px; border-width: 1px; border-color: Ink.edge; background: Ink.surface.with-alpha(0.68);
                    ScrollView { VerticalBox { padding: 18px; spacing: 10px;
                        Caption { text: (root.en ? "POSITION " : "POSIÇÃO ") + (root.slot-index + 1); color: Ink.accent; }
                        LineEdit { text <=> root.slot-name; placeholder-text: root.en ? "Action name" : "Nome da ação"; edited=>{root.preview-slot();} }
                        ComboBox { model: root.en ? ["Empty", "Open app / command", "Website / file / folder", "Keyboard shortcut", "Insert text", "Media", "Window", "System", "Volume", "Submenu", "Macro", "Settings"] : ["Vazia", "Aplicativo / comando", "Site / arquivo / pasta", "Atalho de teclado", "Inserir texto", "Mídia", "Janela", "Sistema", "Volume", "Submenu", "Macro", "Configurações"]; current-index: root.action-type; selected(value) => { root.action-type = self.current-index; } }
                        if root.action-type == 1 || root.action-type == 2: VerticalBox { padding: 0px; spacing: 7px;
                            LineEdit { text <=> root.target; placeholder-text: root.en ? "Path or URL" : "Caminho ou URL"; }
                            Pill { text: root.en ? "Browse…" : "Selecionar…"; clicked => { root.browse-target(); } }
                            if root.action-type == 1: LineEdit { text <=> root.arguments; placeholder-text: root.en ? "Arguments separated by |" : "Argumentos separados por |"; }
                            if root.action-type == 1: CheckBox { text: root.en ? "Run elevated (UAC)" : "Executar elevado (UAC)"; checked <=> root.elevated; }
                        }
                        if root.action-type == 3: LineEdit { text <=> root.shortcut; placeholder-text: "CTRL+SHIFT+S"; }
                        if root.action-type == 4: TextEdit { text <=> root.text-value; min-height: 110px; }
                        if root.action-type == 5: ComboBox { model: root.en ? ["Play / pause", "Next", "Previous", "Stop"] : ["Reproduzir / pausar", "Próxima", "Anterior", "Parar"]; current-index: root.command-index; selected(value) => { root.command-index = self.current-index; } }
                        if root.action-type == 6: ComboBox { model: root.en ? ["Maximize / restore", "Minimize", "Close"] : ["Maximizar / restaurar", "Minimizar", "Fechar"]; current-index: root.command-index; selected(value) => { root.command-index = self.current-index; } }
                        if root.action-type == 7: ComboBox { model: root.en ? ["Lock", "Sleep", "Shut down", "Restart"] : ["Bloquear", "Suspender", "Desligar", "Reiniciar"]; current-index: root.command-index; selected(value) => { root.command-index = self.current-index; } }
                        if root.action-type == 8: VerticalBox { padding: 0px; spacing: 8px;
                            ComboBox { model: ["Windows Master", "Potato / Strip", "Potato / Bus"]; current-index: root.audio-provider; selected(value) => { root.audio-provider = self.current-index; } }
                            if root.audio-provider == 0: ComboBox { model: root.audio-endpoints; current-index: root.audio-endpoint; selected(value)=>{root.audio-endpoint=self.current-index;} }
                            Caption { text: root.en ? "Channel index / step" : "Índice do canal / passo"; }
                            if root.audio-provider != 0: ComboBox { model: root.audio-provider == 2 ? root.bus-labels : root.strip-labels; current-index: root.audio-target; selected(value)=>{root.audio-target=self.current-index;} }
                            Pill { text: root.en ? "Refresh audio targets" : "Atualizar alvos de áudio"; clicked=>{root.refresh-audio();} }
                            Slider { value <=> root.audio-step; minimum: 0.5; maximum: 10; }
                            Caption { text: root.audio-step + (root.audio-provider == 0 ? "% / notch" : " dB / notch"); }
                        }
                        if root.action-type == 9: ComboBox { model: root.menus; current-index: root.submenu-index; selected(value) => { root.submenu-index = self.current-index; } }
                        if root.action-type == 10: VerticalBox { padding: 0px; spacing: 8px;
                            ComboBox { model: root.macro-steps; current-index: root.macro-index; selected(value) => { root.macro-index = self.current-index; } }
                            ComboBox { model: root.en ? ["Shortcut", "Text", "Open", "Command", "Copy slot action"] : ["Atalho", "Texto", "Abrir", "Comando", "Copiar ação de posição"]; current-index: root.macro-kind; selected(value) => { root.macro-kind = self.current-index; } }
                            if root.macro-kind == 4: ComboBox { model: root.macro-source-names; current-index: root.macro-source-slot; selected(value)=>{root.macro-source-slot=self.current-index;} }
                            LineEdit { text <=> root.macro-value; placeholder-text: root.en ? "Step value" : "Valor da etapa"; }
                            SpinBox { value <=> root.macro-delay; minimum: 0; maximum: 600000; }
                            HorizontalBox { padding: 0px; Pill { text: "+"; clicked => { root.macro-add(); } } Pill { text: "−"; clicked => { root.macro-remove(); } } Pill { text: "↑"; clicked => { root.macro-up(); } } }
                        }
                        if root.action-type == 10: Pill { text: root.en ? "Update selected step" : "Atualizar etapa selecionada"; clicked=>{root.macro-update();} }
                        Caption { text: root.en ? "Icon (library name or imported file)" : "Ícone (nome da biblioteca ou arquivo)"; wrap: word-wrap; }
                        LineEdit { text <=> root.icon-name; placeholder-text: "volume · mic · play · folder · copy · settings"; }
                        Pill { text: root.en ? "Browse icon library…" : "Biblioteca de ícones…"; clicked => { root.page = 5; root.refresh-icons(); } }
                        Pill { text: root.en ? "Import image…" : "Importar imagem…"; clicked => { root.import-icon(); } }
                        Pill { text: root.en ? "Icon from executable…" : "Ícone de um executável…"; clicked => { root.import-executable-icon(); } }
                        if root.icon-is-file: Pill { text: root.en ? "Adjust icon filters…" : "Ajustar filtros do ícone…"; clicked => { root.page = 6; } }
                        Caption { text: root.en ? "Icon color" : "Cor do ícone"; }
                        ColorControl { en: root.en; value: root.icon-color-preview; pick => { root.pick-color(200); } alpha-changed(v) => { root.color-opacity(200,v); } reset => { root.reset-color(200); } }
                        Caption { text: root.en ? "This button background" : "Fundo deste botão"; }
                        ColorControl { en: root.en; value: root.button-background-preview; pick => { root.pick-color(201); } alpha-changed(v) => { root.color-opacity(201,v); } reset => { root.reset-color(201); } }
                        Caption { text: root.en ? "This button border" : "Borda deste botão"; }
                        ColorControl { en: root.en; value: root.button-border-preview; pick => { root.pick-color(202); } alpha-changed(v) => { root.color-opacity(202,v); } reset => { root.reset-color(202); } }
                        CheckBox { text: root.en ? "Confirm before executing" : "Confirmar antes de executar"; checked <=> root.confirm; }
                        Pill { text: root.en ? "Save action" : "Salvar ação"; accent: true; clicked => { root.save-slot(); } }
                        if root.action-type == 1: Caption { text: root.en ? "Commands and scripts can modify your files and system. Review the target and arguments." : "Comandos e scripts podem alterar arquivos e o sistema. Revise o destino e os argumentos."; wrap: word-wrap; }
                        Caption { text: root.en ? "Text and commands are stored locally, without encryption." : "Textos e comandos ficam salvos localmente, sem criptografia."; wrap: word-wrap; }
                    } }
                }
            }
            if root.page == 1: Rectangle { border-radius: 18px; border-width: 1px; border-color: Ink.edge; background: Ink.surface.with-alpha(0.68);
                VerticalBox { padding: 24px; spacing: 15px;
                    ComboBox { model: root.profiles; current-index: root.profile-index; selected(value) => { root.profile-index = self.current-index; root.switch-profile(self.current-index); } }
                    Pill { text: root.en ? "Export this profile" : "Exportar este perfil"; clicked=>{root.export-profile();} }
                    LineEdit { text <=> root.profile-name; placeholder-text: root.en ? "Profile name" : "Nome do perfil"; }
                    TextEdit { text <=> root.executables; min-height: 100px; }
                    Pill { text: root.en ? "Add executable…" : "Adicionar executável…"; clicked => { root.browse-executable(); } }
                    Caption { text: root.en ? "Priority (larger wins when rules overlap)" : "Prioridade (maior vence quando regras coincidem)"; }
                    SpinBox { value <=> root.priority; minimum: -999; maximum: 999; }
                    CheckBox { text: root.en ? "Inherit empty slots from Global" : "Herdar posições vazias do Global"; checked <=> root.inherit; }
                    CheckBox { text: root.en ? "Enable capture for this profile / game" : "Habilitar captura neste perfil / jogo"; checked <=> root.profile-enabled; }
                    CheckBox { text: root.en ? "Select profile automatically by executable" : "Selecionar perfil automaticamente por executável"; checked <=> root.automatic; }
                    HorizontalBox { padding: 0px;
                        Pill { text: root.en ? "New" : "Novo"; clicked => { root.new-profile(); } }
                        Pill { text: root.en ? "Duplicate" : "Duplicar"; clicked => { root.duplicate-profile(); } }
                        Pill { text: root.en ? "Remove" : "Remover"; clicked => { root.delete-profile(); } }
                        Pill { text: root.en ? "Save profile" : "Salvar perfil"; accent: true; clicked => { root.save-profile(); } }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
            if root.page == 2: Rectangle { border-radius: 18px; border-width: 1px; border-color: Ink.edge; background: Ink.surface.with-alpha(0.68);
                ScrollView { VerticalBox { padding: 24px; spacing: 13px;
                    Heading { text: root.en ? "Inked / subtle glass" : "Inked / vidro sutil"; }
                    CheckBox { text: "Liquid Glass"; checked <=> root.app-liquid-glass; }
                    HorizontalBox { padding: 0px; for tint in [#000000,#DFDEDC,#A6A7A2,#464545,#00ACAC]: Rectangle { height: 34px; border-radius: 8px; background: tint; border-width: 1px; border-color: Ink.edge; } }
                    Caption { text: root.en ? "App accent" : "Destaque do aplicativo"; }
                    ColorControl { en: root.en; value: Ink.accent; allow-alpha: false; pick => { root.pick-color(101); } reset => { root.reset-color(101); } }
                    ComboBox { model: root.en ? ["Follow Windows", "Dark", "Light"] : ["Seguir Windows", "Escuro", "Claro"]; current-index: root.theme; selected(value) => { root.theme = self.current-index; } }
                    Caption { text: root.en ? "Menu diameter (logical pixels)" : "Diâmetro do menu (pixels lógicos)"; }
                    SpinBox { value <=> root.menu-size; minimum: 280; maximum: 640; }
                    Caption { text: root.en ? "App background color" : "Cor de fundo do aplicativo"; }
                    ColorControl { en: root.en; value: Ink.panel-background; allow-alpha: false; pick => { root.pick-color(100); } reset => { root.reset-color(100); } }
                    Pill { text: root.en ? "Use theme background" : "Usar fundo do tema"; clicked => { root.background-hex = ""; } }
                    Caption { text: (root.en ? "Background opacity: " : "Opacidade do fundo: ") + round(root.glass-strength) + "%"; }
                    Caption { text: root.en ? "0% transparent · 100% solid. Applies to the app only." : "0% transparente · 100% sólido. Aplica-se apenas ao app."; wrap: word-wrap; }
                    Slider { value <=> root.glass-strength; minimum: 0; maximum: 100; }
                    Caption { text: root.en ? "Open menu with" : "Abrir menu com"; }
                    ComboBox { model: root.en ? ["Mouse button", "Keyboard key"] : ["Botão do mouse", "Tecla do teclado"]; current-index: root.trigger-source; selected(value) => { root.trigger-source = self.current-index; } }
                    if root.trigger-source == 0: ComboBox { model: root.en ? ["Middle", "Mouse 4", "Mouse 5", "Left", "Right"] : ["Meio", "Mouse 4", "Mouse 5", "Esquerdo", "Direito"]; current-index: root.mouse-button; selected(value) => { root.mouse-button = self.current-index; } }
                    if root.trigger-source == 0: Caption { text: root.en ? "Left/right activation is disabled inside this editor. Extra vendor buttons must be mapped to a standard mouse button." : "Esquerdo/direito não interceptam cliques neste editor. Botões extras do fabricante precisam estar mapeados para um botão padrão do mouse."; wrap: word-wrap; }
                    if root.trigger-source == 1: ComboBox { model: root.keyboard-options; current-index: root.keyboard-index; selected(value) => { root.select-keyboard-key(self.current-index); } }
                    if root.trigger-source == 1: Caption { text: (root.en ? "Key: " : "Tecla: ") + (root.keyboard-name == "" ? (root.en ? "not configured" : "não configurada") : root.keyboard-name); color: Ink.accent; }
                    if root.trigger-source == 1: Caption { text: root.en ? "Choose a key from the list or capture it below, then Apply preferences. Test activation in another app; typing stays free in this editor." : "Escolha a tecla na lista ou capture abaixo e aplique as preferências. Teste a abertura em outro app; neste editor a digitação fica livre."; wrap: word-wrap; }
                    Pill { text: root.en ? "Capture mouse button or keyboard key (10 s)" : "Capturar botão do mouse ou tecla (10 s)"; clicked=>{root.learn-button();} }
                    CheckBox { text: root.en ? "Hold, move and release (off = click mode)" : "Segurar, mover e soltar (desmarcado = modo clique)"; checked <=> root.hold; }
                    Caption { text: root.en ? "A short tap keeps the menu open. Hold over a submenu to enter; release finishes the gesture." : "Clique curto mantém o menu aberto. Segure sobre um submenu para entrar; soltar finaliza o gesto."; wrap: word-wrap; }
                    SpinBox { value <=> root.hold-ms; minimum: 50; maximum: 2000; }
                    Caption { text: root.en ? "Minimum gesture distance" : "Distância mínima do gesto"; }
                    Slider { value <=> root.distance; minimum: 10; maximum: 180; }
                    CheckBox { text: "English interface"; checked <=> root.en; }
                    CheckBox { text: root.en ? "Start with Windows" : "Iniciar com o Windows"; checked <=> root.startup; }
                    CheckBox { text: root.en ? "Subtle sound feedback" : "Feedback sonoro discreto"; checked <=> root.sounds; }
                    Slider { value <=> root.sound-volume; minimum: 0; maximum: 100; }
                    CheckBox { text: root.en ? "Check for updates automatically" : "Verificar atualizações automaticamente"; checked <=> root.updates; }
                    LineEdit { text <=> root.repository; placeholder-text: "owner/repository"; }
                    Pill { text: root.en ? "Apply preferences" : "Aplicar preferências"; accent: true; clicked => { root.save-settings(); } }
                } }
            }
            if root.page == 4: HorizontalLayout { spacing: 22px;
                Rectangle { border-radius: 18px; border-width: 1px; border-color: Ink.edge; background: Ink.surface; horizontal-stretch: 1;
                    VerticalBox { padding: 18px; spacing: 10px;
                        Heading { text: root.en ? "Menu appearance" : "Aparência do menu"; }
                        Caption { text: root.en ? "Independent from app colors and theme." : "Independente das cores e do tema do aplicativo."; wrap: word-wrap; }
                        Face { zoom: 0.85; min-width: 280px; min-height: 280px; items: root.items; selected: 0; center-title: "MENU"; center-text: "Orbit Axion"; }
                        Caption { text: (root.en ? "Menu opacity: " : "Opacidade do menu: ") + round(root.menu-opacity) + "%"; }
                        Slider { value <=> root.menu-opacity; minimum: 0; maximum: 100; }
                        Pill { text: root.en ? "Save menu appearance" : "Salvar aparência do menu"; accent: true; clicked => { root.save-menu-style(); } }
                        Rectangle { background: transparent; vertical-stretch: 1; }
                    }
                }
                Rectangle { width: 342px; border-radius: 18px; border-width: 1px; border-color: Ink.edge; background: Ink.surface;
                    ScrollView { VerticalBox { padding: 20px; spacing: 10px;
                        CheckBox { text: "Liquid Glass"; checked <=> root.menu-liquid-glass; }
                        if root.menu-liquid-glass: Slider { value <=> root.menu-glass-strength; minimum: 0; maximum: 100; }
                        Caption { text: root.en ? "Center circle radius" : "Raio do círculo central"; }
                        Slider { value <=> root.menu-center-radius; minimum: 24; maximum: 76; }
                        Caption { text: round(root.menu-center-radius) + " px"; }
                        Caption { text: root.en ? "Choose colors visually; the slider controls opacity." : "Escolha as cores visualmente; o controle abaixo ajusta a opacidade."; wrap: word-wrap; }
                        Caption { text: root.en ? "Center circle" : "Círculo central"; }
                        ColorControl { en: root.en; value: MenuInk.center-background; pick => { root.pick-color(11); } alpha-changed(v) => { root.color-opacity(11,v); } reset => { root.reset-color(11); } }
                        Caption { text: root.en ? "Center circle border" : "Borda do círculo central"; }
                        ColorControl { en: root.en; value: MenuInk.center-border; pick => { root.pick-color(12); } alpha-changed(v) => { root.color-opacity(12,v); } reset => { root.reset-color(12); } }
                        Caption { text: root.en ? "Glass highlights" : "Reflexos do vidro"; }
                        ColorControl { en: root.en; value: MenuInk.glass-highlight; pick => { root.pick-color(13); } alpha-changed(v) => { root.color-opacity(13,v); } reset => { root.reset-color(13); } }
                        Caption { text: root.en ? "Background" : "Fundo circular"; }
                        ColorControl { en: root.en; value: MenuInk.background; pick => { root.pick-color(0); } alpha-changed(v) => { root.color-opacity(0,v); } reset => { root.reset-color(0); } }
                        Caption { text: root.en ? "Button background" : "Fundo dos botões"; }
                        ColorControl { en: root.en; value: MenuInk.surface; pick => { root.pick-color(1); } alpha-changed(v) => { root.color-opacity(1,v); } reset => { root.reset-color(1); } }
                        Caption { text: root.en ? "Icons" : "Ícones"; }
                        ColorControl { en: root.en; value: MenuInk.icons; pick => { root.pick-color(2); } alpha-changed(v) => { root.color-opacity(2,v); } reset => { root.reset-color(2); } }
                        Caption { text: root.en ? "Text" : "Texto central"; }
                        ColorControl { en: root.en; value: MenuInk.text; pick => { root.pick-color(3); } alpha-changed(v) => { root.color-opacity(3,v); } reset => { root.reset-color(3); } }
                        Caption { text: root.en ? "Secondary text / empty slots" : "Texto secundário / posições vazias"; }
                        ColorControl { en: root.en; value: MenuInk.muted; pick => { root.pick-color(4); } alpha-changed(v) => { root.color-opacity(4,v); } reset => { root.reset-color(4); } }
                        Caption { text: root.en ? "Borders" : "Bordas"; }
                        ColorControl { en: root.en; value: MenuInk.border; pick => { root.pick-color(5); } alpha-changed(v) => { root.color-opacity(5,v); } reset => { root.reset-color(5); } }
                        Caption { text: root.en ? "Profile / search title" : "Título do perfil / busca"; }
                        ColorControl { en: root.en; value: MenuInk.title; pick => { root.pick-color(6); } alpha-changed(v) => { root.color-opacity(6,v); } reset => { root.reset-color(6); } }
                        Caption { text: root.en ? "Selected background" : "Fundo da seleção"; }
                        ColorControl { en: root.en; value: MenuInk.selection-background; pick => { root.pick-color(7); } alpha-changed(v) => { root.color-opacity(7,v); } reset => { root.reset-color(7); } }
                        Caption { text: root.en ? "Selected icon" : "Ícone selecionado"; }
                        ColorControl { en: root.en; value: MenuInk.selection-icon; pick => { root.pick-color(8); } alpha-changed(v) => { root.color-opacity(8,v); } reset => { root.reset-color(8); } }
                        Caption { text: root.en ? "Selected border" : "Borda da seleção"; }
                        ColorControl { en: root.en; value: MenuInk.selection-border; pick => { root.pick-color(9); } alpha-changed(v) => { root.color-opacity(9,v); } reset => { root.reset-color(9); } }
                        Caption { text: root.en ? "Shadow" : "Sombra"; }
                        ColorControl { en: root.en; value: MenuInk.shadow; pick => { root.pick-color(10); } alpha-changed(v) => { root.color-opacity(10,v); } reset => { root.reset-color(10); } }
                    } }
                }
            }
            if root.page == 5: Rectangle { border-radius: 18px; background: Ink.surface;
                VerticalBox { padding: 20px; spacing: 10px;
                    Heading { text: root.en ? "Icon library" : "Biblioteca de ícones"; }
                    HorizontalBox { padding: 0px;
                        LineEdit { text <=> root.icon-query; placeholder-text: root.en ? "Search icons…" : "Buscar ícones…"; }
                        ComboBox { model: [root.en ? "All icons" : "Todos os ícones", "Bootstrap Icons", "Material Icons", root.en ? "Apps" : "Aplicativos"]; current-index: root.icon-library; selected(v) => { root.icon-library = self.current-index; root.icon-page = 0; root.refresh-icons(); } }
                    }
                    Caption { text: root.icon-count + (root.en ? " icons · page " : " ícones · página ") + (root.icon-page + 1); }
                    ScrollView { VerticalBox { padding: 0px; spacing: 5px;
                        for entry in root.icon-choices: Rectangle { height: 52px; border-radius: 8px; background: Ink.canvas;
                            HorizontalBox { padding: 8px;
                                if entry.image.width > 0: Image { source: entry.image; width: 40px; height: 34px; image-fit: contain; }
                                if entry.image.width == 0: Text { text: entry.glyph; font-family: entry.family; font-size: 26px; color: Ink.text; width: 40px; vertical-alignment: center; }
                                Text { text: entry.label; color: Ink.text; vertical-alignment: center; }
                                Pill { width: 130px; text: root.en ? "Use icon" : "Usar ícone"; clicked => { root.choose-icon(entry.id); } }
                            }
                        }
                    } }
                    HorizontalBox { padding: 0px;
                        Pill { text: root.en ? "Previous" : "Anterior"; clicked => { root.icon-page = max(0,root.icon-page - 1); root.refresh-icons(); } }
                        Pill { text: root.en ? "Next" : "Próxima"; clicked => { root.icon-page += 1; root.refresh-icons(); } }
                        Pill { text: root.en ? "Back to action" : "Voltar à ação"; clicked => { root.page = 0; } }
                    }
                }
            }
            if root.page == 6: Rectangle { border-radius: 18px; background: Ink.surface;
                VerticalBox { padding: 24px; spacing: 12px;
                    Heading { text: root.en ? "Adjust icon" : "Ajustar ícone"; }
                    Caption { text: root.en ? "Live preview. The original image is preserved." : "Prévia em tempo real. A imagem original é preservada."; wrap: word-wrap; }
                    Rectangle { height: 140px; border-radius: 12px; background: Ink.canvas;
                        Image { source: root.items[root.slot-index].image; width: 100px; height: 100px; x: (parent.width - self.width) / 2; y: 20px; image-fit: contain; }
                    }
                    Caption { text: (root.en ? "Black and white: " : "Preto e branco: ") + round(root.icon-grayscale) + "%"; }
                    Slider { value <=> root.icon-grayscale; minimum: 0; maximum: 100; changed(v) => { root.preview-slot(); } }
                    Caption { text: (root.en ? "Brightness: " : "Brilho: ") + round(root.icon-brightness) + "%"; }
                    Slider { value <=> root.icon-brightness; minimum: -100; maximum: 100; changed(v) => { root.preview-slot(); } }
                    Caption { text: (root.en ? "Contrast: " : "Contraste: ") + round(root.icon-contrast) + "%"; }
                    Slider { value <=> root.icon-contrast; minimum: 0; maximum: 200; changed(v) => { root.preview-slot(); } }
                    CheckBox { text: root.en ? "Invert colors" : "Inverter cores"; checked <=> root.icon-invert; toggled => { root.preview-slot(); } }
                    Caption { text: root.en ? "0% black and white restores the original colors. Icon tint is applied separately in the menu." : "0% de preto e branco recupera as cores originais. A cor do ícone é aplicada separadamente no menu."; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalBox { padding: 0px;
                        Pill { text: root.en ? "Reset filters" : "Restaurar filtros"; clicked => { root.icon-grayscale = 0; root.icon-brightness = 0; root.icon-contrast = 100; root.icon-invert = false; root.preview-slot(); } }
                        Pill { text: root.en ? "Back to action" : "Voltar à ação"; clicked => { root.page = 0; } }
                        Pill { text: root.en ? "Save action" : "Salvar ação"; accent: true; clicked => { root.save-slot(); } }
                    }
                }
            }
            if root.page == 3: Rectangle { border-radius: 18px; border-width: 1px; border-color: Ink.edge; background: Ink.surface.with-alpha(0.68);
                VerticalBox { padding: 24px; spacing: 15px;
                    Heading { text: root.en ? "Local, observable, yours." : "Local, observável, seu."; }
                    Text { text: root.diagnostic; color: Ink.text; wrap: word-wrap; }
                    Caption { text: root.update-status; wrap: word-wrap; }
                    HorizontalBox { padding: 0px; Pill { text: root.en ? "Check updates" : "Buscar atualização"; clicked => { root.check-updates(); } } Pill { text: root.en ? "Install update…" : "Instalar atualização…"; clicked => { root.install-update(); } } }
                    HorizontalBox { padding: 0px; Pill { text: root.en ? "Restore backup" : "Restaurar backup"; clicked => { root.restore-backup(); } } Pill { text: root.en ? "Defaults" : "Padrões"; clicked => { root.reset-defaults(); } } }
                    ScrollView { min-height: 100px; Text { text: root.technical-log; color: Ink.muted; font-size: 10px; wrap: word-wrap; } }
                    Pill { text: root.en ? "Open local data" : "Abrir dados locais"; clicked => { root.show-data(); } }
                    Pill { text: root.en ? "Export diagnostic" : "Exportar diagnóstico"; clicked => { root.diagnostics-export(); } }
                    Pill { text: root.en ? "Cancel running macro" : "Cancelar macro em execução"; clicked => { root.cancel-macro(); } }
                    Caption { text: root.en ? "No telemetry. No action history. No cloud configuration." : "Sem telemetria. Sem histórico de ações. Sem configuração na nuvem."; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
            if root.notice != "": Text { text: root.notice; color: Ink.muted; font-size: 12px; wrap: word-wrap; }
            Text { text: root.status; color: Ink.accent; font-size: 12px; wrap: word-wrap; min-height: 30px; }
        }
    }
}
